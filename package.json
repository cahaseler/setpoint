{
	"name": "setpoint",
	"version": "0.0.283",
	"description": "SpaceMolt game client service — declarative multi-account automation via the v2 REST API",
	"license": "MIT",
	"type": "module",
	"workspaces": ["packages/*"],
	"bin": {
		"smctl": "src/cli/index.ts"
	},
	"scripts": {
		"build": "bun build src/index.ts --outdir dist --target bun",
		"build:cli": "bun build src/cli/index.ts --compile --outfile dist/smctl",
		"start": "bun run src/index.ts",
		"dev": "bun run --watch src/index.ts",
		"smctl": "bun run src/cli/index.ts",
		"test": "bun test tests/accounts tests/cli tests/dispatcher tests/server tests/state tests/util packages/*/tests",
		"test:coverage": "bun test --coverage tests/accounts tests/cli tests/dispatcher tests/server tests/state tests/util packages/*/tests",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check": "biome check --write . && biome format --write .",
		"typecheck": "tsc --noEmit && tsc --noEmit -p packages/protocol/tsconfig.json && tsc --noEmit -p packages/client/tsconfig.json",
		"deploy": "bun scripts/deploy.ts",
		"prepare": "git config core.hooksPath .githooks"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/bun": "^1.3.9",
		"typescript": "^5.7.0"
	},
	"dependencies": {
		"@setpoint/protocol": "workspace:*",
		"@spacemolt/lib": "^11.5.0"
	}
}
